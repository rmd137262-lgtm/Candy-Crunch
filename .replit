run = "cd frontend && yarn replit"
modules = ["nodejs-20", "bash", "python-3.12"]

[deployment]
run = ["sh", "-c", "cd frontend && yarn replit"]

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && yarn replit"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
