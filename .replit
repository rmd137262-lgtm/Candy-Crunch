run = "cd frontend && yarn replit"
modules = ["nodejs-20", "bash", "python-3.12"]

[deployment]
run = ["sh", "-c", "cd frontend && yarn replit"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["psmisc"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "packager.installForLanguage"
args = ""

[workflows.workflow.metadata]
outputType = "webview"
